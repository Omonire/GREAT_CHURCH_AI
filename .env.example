# Application environment
#
# Copy to `.env`. Every value below has a working default, so the app runs
# with no configuration at all. Never commit a real key.

# --- Core -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Flask ------------------------------------------------------------------
# Required before any public deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key

# Only needed when the frontend is served from a different origin than the API.
# Comma-separated, e.g. https://church.example,https://www.church.example
CORS_ORIGINS=

# --- Static frontend ---------------------------------------------------------
# Path to the static frontend. The default resolves to `apps/web`.
WEB_DIST=../../../web

# --- Scripture ---------------------------------------------------------------
# Scripture is the bundled public-domain KJV. No key, no network call.
SCRIPTURE_TRANSLATION=KJV
SCRIPTURE_SEARCH_LIMIT=20

# --- AI (optional) -----------------------------------------------------------
# Leave both blank to run browser-only. Set BOTH to move generation server-side
# against any OpenAI-compatible endpoint. The key stays server-side and is never
# sent to the browser.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30.0
AI_MAX_HISTORY=12
